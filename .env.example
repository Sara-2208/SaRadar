# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# LLM providers — at least one must be set
GROQ_API_KEY=
GEMINI_API_KEY=

# Job sourcing (e.g. RapidAPI JSearch or similar)
RAPIDAPI_KEY=

# Telegram bot for fit alerts (chat ID = the user/channel to notify)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
